# =====================================================================
# Environment variables for the LLM-Agent optimization framework.
# Copy this file to `.env` and fill in your own keys.
#   cp env.example .env       (Linux / macOS)
#   copy env.example .env     (Windows)
# Keep `.env` as local runtime configuration.
# =====================================================================

# ---------------------------------------------------------------------
# 1. LLM API access (required to run the agent end-to-end).
#    The framework speaks the OpenAI-compatible REST API and is tested
#    against OpenRouter (which proxies GPT, Claude, Gemini, DeepSeek,
#    Qwen, ...). Replace the URL/key with any compatible provider.
# ---------------------------------------------------------------------
LLM_API_KEY=<your-llm-api-key>
LLM_BASE_URL=https://openrouter.ai/api/v1

# Default model used for the main EvoAgent runs reported in the paper.
LLM_MODEL=gpt-5.2

# Retrieval embeddings used by the paper runs.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small

# ---------------------------------------------------------------------
# 2. Optional: separate API keys for OpenAI / Anthropic / Google AI Studio
#    if you do NOT want to route through OpenRouter.
# ---------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---------------------------------------------------------------------
# 3. Local LLM (e.g. Ollama). Used when --mode local is passed to
#    case_actuator/run_optimization.py or case_robot_leg/run_optimization.py.
# ---------------------------------------------------------------------
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------
# 4. AEDT / Maxwell (case_actuator only).
#    Set to 1 to keep AEDT GUI hidden while solving (default).
# ---------------------------------------------------------------------
# AEDT_NON_GRAPHICAL=1
# AEDT_CLOSE_ON_EXIT=1
